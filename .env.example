# ============================================================
# Some Journey — variáveis de ambiente (EXEMPLO)
# Copie este arquivo para backend/.env e ajuste os valores.
# O .env real NUNCA deve ser versionado (já está no .gitignore).
# ============================================================

# --- PostgreSQL: configuração do container (espelha infra/docker-compose.yml) ---
# Referência da infraestrutura. O backend não lê estas variáveis diretamente;
# ele usa a DATABASE_URL abaixo.
POSTGRES_DB=some_journey
POSTGRES_USER=somejourney
POSTGRES_PASSWORD=somejourney_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Lidas pelo backend (app/core/config.py) ---
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
CORS_ALLOW_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+
TRUSTED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgresql+psycopg://somejourney:somejourney_password@localhost:5433/some_journey

# Gere um forte (>=32 bytes): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_secret_min_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Storage de imagens (Supabase Storage) ---
# OPCIONAL: sem SUPABASE_URL + SUPABASE_SERVICE_KEY o upload de imagem fica
# desabilitado (POST /memories/{id}/image responde 503) e image_url volta null.
# Use um bucket PRIVADO: o backend gera URLs assinadas de curta duração; o
# service key (chave de SERVIÇO, não a anon) NUNCA vai para o cliente.
# SUPABASE_URL é a URL BASE do projeto (https://<ref>.supabase.co) — NÃO a URL
# do Data API com sufixo /rest/v1; o backend já acrescenta /storage/v1 sozinho.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=memories
IMAGE_SIGNED_URL_TTL=3600
MAX_IMAGE_BYTES=5242880
