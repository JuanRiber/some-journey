# ============================================================
# Some Journey — credenciais de PRODUÇÃO para scripts locais (EXEMPLO)
#
# Para rodar, da SUA máquina, os scripts que mexem no banco do ar (checagem,
# seed de testers, reset de senha) sem colar a senha do banco no comando — o que
# a deixaria gravada no histórico do terminal.
#
#   cp production.env.example production.env    # e preencha
#   sh scripts/with_production_env.sh .venv/bin/python -m scripts.check_database
#
# backend/production.env é ignorado pelo git (padrão *.env no .gitignore) e pelo
# Docker (.dockerignore). Nunca o renomeie para algo fora desse padrão.
# ============================================================

APP_ENV=production

# A connection string do SESSION pooler do Supabase (botão Connect), com o
# prefixo trocado para postgresql+psycopg:// e ?sslmode=require no fim. O host
# exato (aws-0 ou aws-1, região) é o que o painel mostrar. Passo a passo em
# docs/12-deploy.md.
DATABASE_URL='postgresql+psycopg://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require'

# Exigida pela configuração (>= 32 caracteres), mas os scripts não emitem token:
# NÃO use o JWT_SECRET_KEY do Render aqui — um segredo a menos fora do cofre.
# Gere qualquer um: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY='troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres'
